# =========================================================================
# Naukari Adda - environment configuration
#
# Copy this file to `.env` in the same directory as manage.py and fill in
# real values. `.env` is git-ignored and must NEVER be committed.
#
#     cp .env.example .env
# =========================================================================


# -------------------------------------------------------------------------
# Django core
# -------------------------------------------------------------------------
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma separated. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated, only needed behind HTTPS / a custom domain.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

DJANGO_TIME_ZONE=Asia/Kolkata


# -------------------------------------------------------------------------
# Email (interview + application status notifications)
# -------------------------------------------------------------------------
# If EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are left blank, the project
# automatically uses Django's console backend: emails are printed to the
# terminal instead of being delivered. Nothing crashes either way.
#
# For Gmail you must use a 16-character App Password, NOT your normal
# account password. Enable 2-Step Verification first, then create one at:
#   https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# Shown as the sender. Defaults to EMAIL_HOST_USER when blank.
DEFAULT_FROM_EMAIL=

# Force a specific backend (optional). Leave blank for auto-detection.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# -------------------------------------------------------------------------
# Claude / Anthropic (optional)
# -------------------------------------------------------------------------
# Leave blank to run entirely on the built-in rule-based matcher.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5


# -------------------------------------------------------------------------
# OCR tool locations
# -------------------------------------------------------------------------
# Leave BOTH blank on Linux/macOS when tesseract and pdftoppm are on PATH.
# On Windows, point them at your installs, for example:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   POPPLER_PATH=C:\poppler\Library\bin
TESSERACT_CMD=
POPPLER_PATH=


# -------------------------------------------------------------------------
# Resume uploads
# -------------------------------------------------------------------------
RESUME_MAX_SIZE_MB=5


# -------------------------------------------------------------------------
# Production-only hardening (ignored while DJANGO_DEBUG=True)
# -------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_EXPIRE_AT_BROWSER_CLOSE=False
